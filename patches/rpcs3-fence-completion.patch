diff --git a/rpcs3/Emu/RSX/VK/VKPresent.cpp b/rpcs3/Emu/RSX/VK/VKPresent.cpp
index d98e469..c15b5fb 100644
--- a/rpcs3/Emu/RSX/VK/VKPresent.cpp
+++ b/rpcs3/Emu/RSX/VK/VKPresent.cpp
@@ -247,10 +247,17 @@ void VKGSRender::frame_context_cleanup(vk::frame_context_t *ctx)
 	ensure(ctx->swap_command_buffer);
 
 	// Perform hard swap here
-	if (ctx->swap_command_buffer->wait(FRAME_PRESENT_TIMEOUT) != VK_SUCCESS)
+	auto wait_result = ctx->swap_command_buffer->wait(FRAME_PRESENT_TIMEOUT);
+	if (wait_result == VK_TIMEOUT)
+	{
+		// The frame's resources and heap snapshot still belong to pending work.
+		wait_result = ctx->swap_command_buffer->wait();
+	}
+	if (wait_result != VK_SUCCESS)
 	{
 		// Lost surface/device, release swapchain
 		swapchain_unavailable = true;
+		CHECK_RESULT(wait_result);
 	}
 
 	// Resource cleanup.
