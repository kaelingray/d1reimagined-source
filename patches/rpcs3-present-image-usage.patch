+	// Opt-in bounded source/format evidence; no pixel dumps or behavior changes.
+	// One line per two seconds, at most 200 per d1/d1media.on activation.
+	{
+		static u64 last_check = 0, last_line = 0;
+		static bool enabled = false;
+		static u32 lines = 0;
+		const u64 now = get_system_time();
+		if (now - last_check > 500'000)
+		{
+			last_check = now;
+			const bool requested = fs::is_file(d1diag::ctl_dir() + "d1media.on");
+			if (requested && !enabled) { lines = 0; last_line = 0; }
+			enabled = requested;
+		}
+		if (enabled && lines < 200 && now - last_line > 2'000'000)
+		{
+			last_line = now;
+			++lines;
+			const auto kind = [](const present_source& source)
