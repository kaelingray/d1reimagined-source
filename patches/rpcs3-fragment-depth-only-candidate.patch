new file mode 100644
--- /dev/null
+++ b/rpcs3/Emu/RSX/Program/FragmentDepthOnly.h
@@ -0,0 +1,42 @@
+#pragma once
+#include <array>
+#include <cstdint>
+
+namespace rsx::fragment_depth_only
+{
+	struct draw_state
+	{
+		std::uint32_t offset = 0;
+		std::uint32_t location = 0;
+		std::uint32_t control = 0;
+		std::uint32_t varying_mask = 0;
+		std::array<bool, 4> color_writes{};
+		bool alpha_test = false;
+		bool alpha_to_coverage = false;
+		bool polygon_stipple = false;
+		bool texture_alpha_kill = false;
+	};
+
+	// Experimental zero-local binding path. Preserve the raster draw and its
+	// fixed-function depth/stencil/occlusion work; only fragment execution is empty.
+	constexpr bool eligible(const draw_state& state, std::uint32_t fragment_effect_mask)
+	{
+		if (state.offset || state.location || state.varying_mask ||
+			(state.control & fragment_effect_mask) || state.alpha_test ||
+			state.alpha_to_coverage || state.polygon_stipple || state.texture_alpha_kill)
+		{
+			return false;
+		}
+		for (bool enabled : state.color_writes)
+		{
+			if (enabled) return false;
+		}
+		return true;
+	}
+
+	constexpr std::array<std::uint32_t, 4> end_nop()
+	{
+		// RSX's half-word-swapped instruction encoding: NOP with END, no literals.
+		return {0x00000100u, 0u, 0u, 0u};
+	}
+}
