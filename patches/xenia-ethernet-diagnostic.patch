 dword_result_t NetDll_XNetGetEthernetLinkStatus_entry(dword_t caller) {
+  // Diagnostic only: isolate Destiny's link-status check from sign-in and
+  // service availability. This does not establish an Internet connection.
+  static const bool test_active = [] {
+    const char* value = std::getenv("XENIA_TEST_ETHERNET_ACTIVE");
+    return value && std::strcmp(value, "1") == 0;
+  }();
+  if (test_active) {
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true, std::memory_order_relaxed)) {
+      XELOGW("Diagnostic override: reporting Ethernet link active");
+    }
+    return XEthernetStatus::XNET_ETHERNET_LINK_ACTIVE;
+  }
   return 0;
 }
 DECLARE_XAM_EXPORT1(NetDll_XNetGetEthernetLinkStatus, kNetworking, kStub);
