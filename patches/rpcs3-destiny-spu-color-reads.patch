+	// Destiny (BLES01857): with Read Color Buffers on, a colour target in video memory is loaded
+	// from guest memory only when SPU DMA has written to its range (rsx::local_mem_write_gen).
+	// Loading never-written video memory put stale data into the 01.24 setup menus as magenta
+	// blocks; the SPU-written HDR/lighting targets that character and mission lighting need are
+	// still read. Targets in main memory keep the plain setting.
+	static bool read_color_memory(u32 base_addr, const rsx::address_range32& range)
+	{
+		if (!g_cfg.video.read_color_buffers)
+		{
+			return false;
+		}
+
+		return (base_addr >> 28) != 0xC || rsx::local_mem_write_gen(range.start, range.length()) != 0;
+	}
