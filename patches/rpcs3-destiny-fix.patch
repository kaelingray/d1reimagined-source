diff --git a/rpcs3/Emu/RSX/Common/local_mem_writes.h b/rpcs3/Emu/RSX/Common/local_mem_writes.h
new file mode 100644
index 000000000..50448c292
--- /dev/null
+++ b/rpcs3/Emu/RSX/Common/local_mem_writes.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "util/types.hpp"
+#include <atomic>
+
+namespace rsx
+{
+	// Write generations per 4KB page of RSX local memory (0xC0000000-0xCFFFFFFF), bumped by writers the
+	// surface cache cannot otherwise observe (SPU DMA puts into video memory). Render targets snapshot the
+	// sum over their pages whenever their memory tag is synced and treat any change as a memory write.
+	inline std::atomic<u32> g_local_mem_write_gen[0x10000]{};
+
+	inline void notify_local_mem_write(u32 addr, u32 size)
+	{
+		if (!size || (addr >> 28) != 0xC)
+		{
+			return;
+		}
+
+		const u32 first = (addr & 0x0fffffff) >> 12;
+		const u32 last = std::min<u64>(u64{addr & 0x0fffffff} + size - 1, 0x0fffffff) >> 12;
+
+		for (u32 page = first; page <= last; ++page)
+		{
+			g_local_mem_write_gen[page].fetch_add(1, std::memory_order_release);
+		}
+	}
+
+	inline u64 local_mem_write_gen(u32 addr, u32 size)
+	{
+		if (!size || (addr >> 28) != 0xC)
+		{
+			return 0;
+		}
+
+		const u32 first = (addr & 0x0fffffff) >> 12;
+		const u32 last = std::min<u64>(u64{addr & 0x0fffffff} + size - 1, 0x0fffffff) >> 12;
+
+		u64 sum = 0;
+		for (u32 page = first; page <= last; ++page)
+		{
+			sum += g_local_mem_write_gen[page].load(std::memory_order_acquire);
+		}
+
+		return sum;
+	}
+}
