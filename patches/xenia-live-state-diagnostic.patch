 #include <map>
 #include <memory>
 #include <string>
@@ -109,6 +111,15 @@ class UserProfile {
 
   std::string name() const { return account_info_.GetGamertagString(); }
   uint32_t signin_state() const {
+    // Diagnostic only: test whether Destiny's first sign-in gate requires
+    // a Live sign-in state. No Live authentication or network service is added.
+    static const bool test_live = [] {
+      const char* value = std::getenv("XENIA_TEST_LIVE_STATE");
+      return value && std::strcmp(value, "1") == 0;
+    }();
+    if (test_live) {
+      return static_cast<uint32_t>(SignInState::SignedInToLive);
+    }
     return static_cast<uint32_t>(SignInState::SignedInLocally);
   };
   uint32_t type() const { return 1 | 2; /* local | online profile? */ }
