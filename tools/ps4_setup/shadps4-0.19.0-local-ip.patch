+// D1-PRESERVATION FORK-LOCAL CHANGE - NOT AN UPSTREAM FIX.
+// The stock probe connect()s a TCP socket to 1.1.1.1:80 and reads getsockname(). Under a contained
+// lab (no route off the box, or an emulator firewall block) that real handshake fails and the guest
+// is told 127.0.0.1, which Destiny rejects as a transport. Instead:
+//   1. D1_GUEST_IP, if set, names the guest address explicitly. It is used only if it is an
+//      address of this machine (a UDP socket can bind to it).
+//   2. Otherwise a UDP route probe: connect() on a datagram socket only selects the route and the
+//      source address. It sends no packet and cannot block.
+static bool IsLocalIpv4(const char* text, in_addr* out) {
+    if (inet_pton(AF_INET, text, out) != 1 || out->s_addr == htonl(INADDR_LOOPBACK)) {
+        return false;
+    }
+    auto probe = socket(AF_INET, SOCK_DGRAM, 0);
+    if (probe == -1) {
+        return false;
+    }
+    sockaddr_in local{};
+    local.sin_family = AF_INET;
+    local.sin_addr = *out;
+    const bool bound = bind(probe, (sockaddr*)&local, sizeof(local)) == 0;
+#ifdef _WIN32
+    closesocket(probe);
+#else
+    ::close(probe);
+#endif
+    return bound;
+}
