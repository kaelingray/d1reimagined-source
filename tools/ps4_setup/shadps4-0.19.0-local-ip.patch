+            ip = text;
+            LOG_INFO(Lib_Net, "local ip {} (D1_GUEST_IP)", ip);
+            return true;
+        }
+        LOG_ERROR(Lib_Net, "D1_GUEST_IP={} is not an address of this machine; ignored", guest);
